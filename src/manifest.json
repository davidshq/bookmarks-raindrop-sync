{
  "manifest_version": 3,
  "name": "Bookmarks ↔ Raindrop Sync",
  "version": "0.1.0",
  "description": "Sync Chromium browser bookmarks with Raindrop.io (one-way or bidirectional), captured as you create them.",
  "permissions": ["bookmarks", "storage", "alarms"],
  "host_permissions": ["https://api.raindrop.io/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bookmarks ↔ Raindrop Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
