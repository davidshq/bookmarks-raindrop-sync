{
  "name": "bookmarks-raindrop-sync",
  "private": true,
  "type": "module",
  "description": "Manifest V3 Chromium extension: sync browser bookmarks with Raindrop.io",
  "scripts": {
    "test": "node scripts/verify-bidirectional-logic.mjs && node scripts/verify-checklist.mjs",
    "test:live": "node scripts/verify-bidirectional-logic.mjs && node scripts/verify-checklist.mjs --live",
    "test:integration": "node scripts/verify-integration.mjs",
    "spike": "node scripts/spike-raindrop.mjs",
    "pack": "node scripts/pack-extension.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,html,css,json}\" \"scripts/**/*.{js,mjs}\" eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{js,html,css,json}\" \"scripts/**/*.{js,mjs}\" eslint.config.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  }
}
